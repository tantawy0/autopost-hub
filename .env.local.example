# Public browser-safe values
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_APP_URL=http://localhost:3003

# Server-only Supabase and cron values
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
CRON_SECRET=replace-with-a-long-random-secret
TOKEN_ENCRYPTION_KEY=replace-with-a-stable-32-byte-random-secret

# Real-browser E2E tests
# Generate local credentials with: npm run setup:e2e
E2E_RUN_BROWSER=0
E2E_START_SERVER=0
E2E_EMAIL=e2e-user@example.test
E2E_PASSWORD=replace-with-e2e-password

# Supabase Auth social providers
# Configure Google and GitHub provider client IDs/secrets in the Supabase dashboard.
# Provider callback URL:
# https://your-project.supabase.co/auth/v1/callback

# Stripe billing
# Optional until paid plans are ready. Server-side only.
STRIPE_SECRET_KEY=replace-with-stripe-secret-key
STRIPE_WEBHOOK_SECRET=replace-with-stripe-webhook-secret
STRIPE_PRICE_CREATOR=price_creator_monthly
STRIPE_PRICE_PRO=price_pro_monthly
STRIPE_PRICE_AGENCY=price_agency_monthly

# Meta OAuth / Graph API
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
META_REDIRECT_URI=http://localhost:3003/api/meta/callback
# Optional:
# META_GRAPH_VERSION=v25.0
# META_SCOPES=pages_show_list,pages_read_engagement,pages_manage_posts,instagram_basic,instagram_content_publish

# Instagram Login OAuth
# Optional but recommended for a standalone Instagram connect button.
# If omitted, the app can fall back to META_APP_ID/META_APP_SECRET but the callback
# URL still needs to be registered in the Instagram product.
# INSTAGRAM_APP_ID=your-instagram-app-id
# INSTAGRAM_APP_SECRET=your-instagram-app-secret
# INSTAGRAM_REDIRECT_URI=http://localhost:3003/api/instagram/callback
# INSTAGRAM_SCOPES=instagram_business_basic,instagram_business_content_publish
# INSTAGRAM_API_VERSION=v25.0
# INSTAGRAM_WEBHOOK_VERIFY_TOKEN=replace-with-a-long-random-webhook-verify-token

# LinkedIn OAuth / Posts API
# Optional until LinkedIn publishing is enabled for a workspace:
# LINKEDIN_CLIENT_ID=your-linkedin-client-id
# LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
# LINKEDIN_REDIRECT_URI=http://localhost:3003/api/linkedin/callback
# LINKEDIN_API_VERSION=202605
# LINKEDIN_SCOPES=openid,profile,email,w_member_social

# AI provider routes
# Optional:
# AI_PRIMARY_PROVIDER=heuristic
# GEMINI_API_KEY=replace-with-gemini-api-key
# GEMINI_MODEL=gemini-1.5-flash
# OPENROUTER_API_KEY=replace-with-openrouter-api-key
# AI_MODEL_ASSISTANT=heuristic-v1
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# AI_REQUEST_TIMEOUT_MS=30000
# AI_MAX_RETRIES=2

# 21st SDK token/agent integration
API_KEY_21ST=replace-with-21st-api-key
# Provider secrets for deployed 21st agents also belong in the 21st dashboard env vars for my-agent.
